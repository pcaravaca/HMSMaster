# Copy to env.production and fill real values before running docker compose.
POSTGRES_USER=hms_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hmsmaster
DATABASE_URL=postgres://hms_user:change_me@db:5432/hmsmaster?sslmode=disable
PORT=8080
FRONTEND_PORT=80
# POSMaster invoice bridge (optional; omit to keep folio charges local)
POSMASTER_API_URL=
POSMASTER_API_TOKEN=
POSMASTER_TIENDA_ID=
POSMASTER_FORMA_PAGO=efectivo
